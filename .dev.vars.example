# Secrets for local development with `npm run dev` (copy to .dev.vars).
# In production, set each with `npx wrangler secret put <NAME>`.
SLACK_SIGNING_SECRET=
PIRATE_WEATHER_API_KEY=
GOOGLE_GEOCODING_API_KEY=
# Optional: bearer token for the JSON API used by the Slack agent (/api/forecast).
AGENT_API_TOKEN=
