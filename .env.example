# Slack app credentials (Slack app settings > Basic Information)
SLACK_SIGNING_SECRET=
# Optional; not needed for slash commands
SLACK_BOT_TOKEN=

# Weather data: https://pirateweather.net (Dark Sky-compatible API)
PIRATE_WEATHER_API_KEY=

# Google Maps Geocoding API
GOOGLE_GEOCODING_API_KEY=

# Comma-separated Slack IDs allowed to see debug info when a command fails
ADMIN_USER_IDS=U0VTT5EHL
ADMIN_TEAM_IDS=T02996B3M

# Location used when /weather is called with no place
DEFAULT_LATITUDE=28.480
DEFAULT_LONGITUDE=-81.455
DEFAULT_LOCATION_LABEL=at Concepta HQ

PORT=3000
