{
  "name": "weatherman",
  "version": "2.0.0",
  "description": "Weatherman: a weather app for Slack",
  "private": true,
  "license": "UNLICENSED",
  "author": "Alden Gillespy",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@slack/bolt": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
